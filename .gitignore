# ══════════════════════════════════════════════════════════════════════════
#  ~/.dsh 仓库 — 只跟踪「跨设备有意义的配置层」
#  运行时数据、本机状态、密钥一律不进仓库。新增内容前先读 README.md。
# ══════════════════════════════════════════════════════════════════════════

# ── 密钥：永不入库 ────────────────────────────────────────────────────────
# 真值文件（version: 1 + refs，DSH 的私有存储；启动环境 > 它 > .env）
.credentials.yaml
# 手工备份（含已删除的旧 key，仅本机保留，绝不提交）
.credentials.yaml.bak-*
# 环境层（本机专属，且会成为一份本机凭据）
.env
**/.env

# ── 会话与附件：纯本机运行时数据 ──────────────────────────────────────────
# sessions/ 的目录名按项目路径编码（--home-sx-projects-MyAI--），换设备即失效
sessions/
attachments/
cache/

# ── 存储与服务状态 ────────────────────────────────────────────────────────
# workspace.json / session_projcache.json 里全是本机绝对路径，跨设备会互相覆盖
storages/
# 含 -shm / -wal 两个 SQLite 伴随文件
session-search.db*
task-manager/
# DeepSeek 文件上传索引（files-v3.json，本机运行时状态）
llm-deepseek/

# ── 技能：根目录 301 条全是软链，由 install-skill.sh 从仓库外部生成 ────────
# 只锚根目录！`.agent-presets/*/skills/` 是 preset 自带的技能，必须跟踪。
/skills/

# ── 本机专属脚本与状态 ────────────────────────────────────────────────────
# bin/hypr-place 依赖本机 Hyprland；evolve/ 含 rubric.key 与运行时日志
bin/
evolve/

# ── 依赖与构建产物 ────────────────────────────────────────────────────────
node_modules/
.dsh-module-fallback/
patches/
*.log

# ── 运行时噪音 ────────────────────────────────────────────────────────────
# install-skill.sh --force 前的真实目录备份，本机专属
skill-backups/
.anonymous-user-id
remote-web-ui-devices.json
*.tmp
*.swp
.DS_Store

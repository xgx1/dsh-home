# ══════════════════════════════════════════════════════════════════════════
#  ~/.dsh 仓库 — 只跟踪「跨设备有意义的配置层」
#  运行时数据、本机状态、密钥一律不进仓库。新增内容前先读 README.md。
# ══════════════════════════════════════════════════════════════════════════

# ── 密钥：永不入库 ────────────────────────────────────────────────────────
# 真值文件（version: 1 + refs，DSH 的私有存储；启动环境 > 它 > .env）
.credentials.yaml
# 手工备份（含已删除的旧 key，仅本机保留，绝不提交）
.credentials.yaml.bak-*
# 环境层（本机专属，且会成为一份本机凭据）
.env
**/.env

# ── 会话与附件：纯本机运行时数据 ──────────────────────────────────────────
# sessions/ 的目录名按项目路径编码（--home-sx-projects-MyAI--），换设备即失效
sessions/
attachments/
cache/

# ── 存储与服务状态 ────────────────────────────────────────────────────────
# workspace.json / session_projcache.json 里全是本机绝对路径，跨设备会互相覆盖
storages/
# 含 -shm / -wal 两个 SQLite 伴随文件
session-search.db*
# dsh-guard 的运行状态（findings/state），只在本机有意义
guard/
# dsh-observe / dsh-desktops 的运行产物（截图、lastest.json、事件流），纯本机数据
watch/
# agent 桌面的运行时目录（desk.json / env.sh / 日志），纯本机状态
agent-desktops/
task-manager/
# DeepSeek 文件上传索引（files-v3.json，本机运行时状态）
llm-deepseek/

# ── 技能：根目录 301 条全是软链，由 install-skill.sh 从仓库外部生成 ────────
# 只锚根目录！`.agent-presets/*/skills/` 是 preset 自带的技能，必须跟踪。
/skills/

# ── 本机专属脚本与状态 ────────────────────────────────────────────────────
# bin/hypr-place 依赖本机 Hyprland；evolve/ 含 rubric.key 与运行时日志
bin/*
!bin/gen-project-presets.py
!bin/opencode-zen-bridge.py
# 2026-10-23：这两个是本机运行链路的一部分（profile 的 MCP command 直接指 zg-autoidx），
# 必须入库，否则换机/回滚后 zvec 自动建索引与 scope 清理就没了。
!bin/zg-autoidx.mjs
!bin/dsh-janitor.sh
# 2026-11-05：会话监察（只读扫各会话越界动作），运行链路的一部分，必须入库
!bin/dsh-guard.py
# 2026-11-05：桌面观察台 —— 我的桌面（observe）+ 别的桌面（desktops）+ 只读展示页（view）
!bin/dsh-observe.py
!bin/dsh-desktops.py
!bin/dsh-view.py
# 2026-11-06：agent 桌面（GUI 默认落点）+ 生产桌面包装脚本
!bin/agent-desktop.py
!bin/agent-shell-env.sh
!bin/prod-niri
!bin/prod-xdo
!bin/prod-grim
!bin/agent-niri
evolve/

# ── 依赖与构建产物 ────────────────────────────────────────────────────────
node_modules/
.dsh-module-fallback/
patches/
*.log

# ── 运行时噪音 ────────────────────────────────────────────────────────────
# 启动/重载日志与探活脚本（startup-*.log、last-restart.txt、dsh-web-reload-verify.*）
logs/
# install-skill.sh --force 前的真实目录备份，本机专属
skill-backups/
.anonymous-user-id
remote-web-ui-devices.json
*.tmp
*.swp
.DS_Store

# 技能过滤：上一次有效配置的回落缓存（本机运行时数据）
.skill-filter-cache.json

# settings.yaml 迁移（0.2.1）：运行时改名残留与手工备份不入库
settings.yaml
settings.yaml.imported
settings.yaml.bak-*
speech-to-text/
*.bak-*

# session-manager 运行时问答台账（纯本机状态）
manager-questions/

# agent 临时产物（验证日志、构建输出），见 AGENTS.md「会话产物落点」
tmp/

# ── Windows 本机（windows 分支专用） ──────────────────────────────────────
# 本机备份目录与运行时小状态
backups/
pet.json
# 从 Linux home 拷来的遗留 unit：本机没有 systemd，别入库
deploy/systemd-user/headroom-*.service
*.bak

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PONYTAIL_DEFAULT_MODE=ultra PLUGIN_DATA=/tmp/ponytail-state node /home/sx/projects/MyAI/dsh-extensions/skills/dietrichgebert-ponytail/hooks/ponytail-activate.js",
            "timeout": 10,
            "statusMessage": "Loading ponytail (ultra)..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PONYTAIL_DEFAULT_MODE=ultra PLUGIN_DATA=/tmp/ponytail-state node /home/sx/projects/MyAI/dsh-extensions/skills/dietrichgebert-ponytail/hooks/ponytail-mode-tracker.js",
            "timeout": 10,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  }
}
